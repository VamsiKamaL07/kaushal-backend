# Local development defaults. Render values belong in its Environment settings.
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///kaushalx.db
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Resend is recommended on Render; SMTP is for local development only.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
